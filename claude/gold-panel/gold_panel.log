. *========================================================= axis range per pan
> el
. * Each panel gets its own range. A single shared range was tried and rejected
> :
. * the two panels count different things - a commodity's trade with the whole
. * world against one partner's gold trade - so a common absolute scale invites
. * a comparison that is not well defined, and it costs roughly half the
. * plotting area to emptiness. Formatting is identical; only the limits differ
> .
. local i = 0

. foreach f in `comm' `part' {
  2.     local ++i
  3.     use "`f'", clear
  4.     local lo = .
  5.     local hi = .
  6.     foreach v in mb ms mr xb xs xr {
  7.         qui su `v'
  8.         local lo = min(`lo', r(min))
  9.         local hi = max(`hi', r(max))
 10.     }
 11.     local LO`i' = `lo' * 0.40
 12.     local HI`i' = `hi' * 3.2
 13. 
.     * Decade ticks built from the range rather than hardcoded. A fixed list
.     * leaves an orphan label floating outside the plot whenever a value falls
.     * below the panel's floor.
.     local TK`i' ""
 14.     forvalues e = -4/2 {
 15.         local v = 10^(`e')
 16.         if `e' == -4 local lb "0.0001"
 17.         if `e' == -3 local lb "0.001"
 18.         if `e' == -2 local lb "0.01"
 19.         if `e' == -1 local lb "0.1"
 20.         if `e' ==  0 local lb "1"
 21.         if `e' ==  1 local lb "10"
 22.         if `e' ==  2 local lb "100"
 23.         if (`v' >= `LO`i'') & (`v' <= `HI`i'') {
 24.             * Compound double quotes on both sides. The accumulator alread
> y
.             * holds quoted labels, so a plain "`TK`i''" on the right-hand sid
> e
.             * closes on the first one it meets and the rest becomes syntax.
.             local TK`i' `"`TK`i'' `v' "`lb'""'
 25.         }
 26.     }
 27.     di as txt "panel `i' range: " as res %8.4f `LO`i'' as txt " .. " ///
>         as res %8.2f `HI`i''
 28.     * Same reason, again: echoing the tick list needs compound quotes or t
> he
.     * display command itself dies on r(198) after the figure is already built
> .
.     di as txt `"  ticks: `TK`i''"'
 29. }
panel 1 range:   0.0070 ..    72.18
  ticks:  .01 "0.01" .1 "0.1" 1 "1" 10 "10"
panel 2 range:   0.0009 ..    35.17
  ticks:  .001 "0.001" .01 "0.01" .1 "0.1" 1 "1" 10 "10"

