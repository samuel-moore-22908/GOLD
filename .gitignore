# Data — not committed. See DATA_SOURCES.md for fetch procedures.
data/*
!data/.gitkeep
!data/README.md
*.csv
*.xlsx
*.xls
*.parquet

# Licensed / paid sources — never commit these
**/metalsfocus/
**/goldchartsrus/
**/wgc_goldhub/

# Credentials
.env
.env.*
*_token
*.key
credentials.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Output artefacts — regenerate from source
figures/*.png
figures/*.pdf
output/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp

# Exploratory scratch work is retained as a record
!exploratory/*.csv
!exploratory/*.png
claude/gold-panel/gold_panel_run.log
claude/gold-panel/probe/
claude/*/[a-z_]*_run.log

# gold_final: logs and data regenerate from the pull scripts. The figures
# are committed because they are the deliverable. The exception is the raw
# HS10 customs pull, committed so the manual tonnage work rests on a fixed
# vintage of Census data.
gold_final/**/*.log
gold_final/data/*
!gold_final/data/raw/
gold_final/data/raw/*
!gold_final/data/raw/us_gold_hs10_imports_monthly.csv
!gold_final/data/raw/us_gold_hs10_exports_monthly.csv

# LaTeX build artefacts - the .tex and the .pdf are the record
*.aux
*.out
*.ent
*.toc
*.synctex.gz
